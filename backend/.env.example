# 이 파일을 같은 폴더에 .env 로 복사한 뒤, 쓰려는 LLM의 키 하나만 채우세요.
# 키가 하나도 없으면 규칙 기반 파서로 동작합니다 (LangChain 챌린지 시연에는 키가 필요합니다).
# .env 는 .gitignore 에 들어 있어 제출 코드에 포함되지 않습니다. 키를 다른 곳에 붙여 넣지 마세요.

# [추천·무료] Google Gemini — https://aistudio.google.com/apikey 에서 Google 계정으로 발급 (카드 등록 없음)
#   무료 등급은 분당·하루 호출 수 제한이 있습니다. 현재 한도는 https://aistudio.google.com/rate-limit 에서 확인.
GOOGLE_API_KEY=

# [예비·무료] Groq — https://console.groq.com/keys 에서 발급 (카드 등록 없음)
#   Gemini 한도에 걸리거나 키가 막혔을 때 대신 씁니다.
GROQ_API_KEY=

# 유료 키를 쓸 때만
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 모델을 직접 지정하려면 "제공사:모델" 형식으로 적습니다. 비워 두면 위에서 채운 키 순서대로 자동 선택합니다.
#   Gemini 기본값: google_genai:gemini-flash-latest   (최신 Flash를 가리키는 별칭)
#   한도가 부족하면: google_genai:gemini-flash-lite-latest   (더 가볍고 무료 한도가 넉넉함)
#   Groq 기본값:  groq:qwen/qwen3.8-27b   (llama-3.3-70b-versatile은 서비스 종료)
LLM_MODEL=
