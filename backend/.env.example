# OpenAI GPT only. app/.openai_api_key takes precedence over this variable.
# The key file and .env are excluded from Git.
OPENAI_API_KEY=

# Default GPT model; other providers are ignored.
LLM_MODEL=openai:gpt-6-luna

# rule (default): RAG disabled. Set rag to reconnect the original GPT RAG.
KAC_ALLERGY_PROVIDER=rule
# Optional absolute path when multiple dictionaries exist in data/.
KAC_ALLERGEN_DICTIONARY=

# User-facing answer style: concise (default) or friendly.
KAC_REPLY_STYLE=concise
